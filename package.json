{
  "name": "jhosue-labs-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portfólio da Jhosue Labs — software, automação e inteligência artificial.",
  "scripts": {
    "dev": "astro dev --port 8090 --host",
    "start": "astro dev --port 8090 --host",
    "build": "astro build",
    "preview": "astro preview --port 8090 --host",
    "preview:e2e": "node tests/e2e/static-server.mjs 8099",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "astro": "^5.14.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.36.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource-variable/space-grotesk": "^5.2.5",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.1",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^9.36.0",
    "eslint-plugin-astro": "^1.3.1",
    "jsdom": "^26.1.0",
    "pdfjs-dist": "^6.2.108",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.11.0"
  }
