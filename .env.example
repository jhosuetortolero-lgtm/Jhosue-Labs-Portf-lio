# =============================================================================
# Jhosue Labs — variáveis de ambiente
# =============================================================================
# Copie este arquivo para `.env` e preencha o que for usar.
#
# ATENÇÃO: tudo que começa com PUBLIC_ é embutido no HTML/JS final e fica
# visível para qualquer visitante. NÃO são segredos. Nunca coloque aqui
# chaves privadas, tokens de API com permissão de escrita ou senhas.
# =============================================================================

# URL absoluta final do site (canonical, Open Graph, sitemap)
PUBLIC_SITE_URL=https://jhosue-labs.example.com

# Caminho base. "/" para domínio próprio, Cloudflare, Netlify e Vercel.
# "/nome-do-repositorio/" quando publicado em usuario.github.io/nome-do-repositorio/
PUBLIC_BASE_PATH=/

# -----------------------------------------------------------------------------
# Formulário de contato
# -----------------------------------------------------------------------------
# Provedor: demo | formspree | emailjs | api
# "demo" (padrão) valida tudo no navegador e apenas simula o envio.
PUBLIC_CONTACT_PROVIDER=demo

# Formspree — https://formspree.io  (endpoint público do formulário)
PUBLIC_FORMSPREE_ENDPOINT=

# EmailJS — https://www.emailjs.com  (as três chaves são públicas por design)
PUBLIC_EMAILJS_PUBLIC_KEY=
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=

# Endpoint próprio (função serverless ou backend) que aceita POST JSON
PUBLIC_CONTACT_API_URL=
