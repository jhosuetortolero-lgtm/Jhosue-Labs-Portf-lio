---
import Icon from '../common/Icon.astro';
import { useTranslations } from '../../i18n';
import { DEFAULT_LANGUAGE } from '../../types/i18n';
import type { TimelineItem, TimelineType } from '../../types/timeline';

export interface Props {
  item: TimelineItem;
  index?: number;
}

const { item, index = 0 } = Astro.props;
const t = useTranslations(DEFAULT_LANGUAGE);

const iconByType: Record<TimelineType, string> = {
  career: 'briefcase',
  education: 'graduation',
  project: 'rocket',
  achievement: 'award',
};

const period = t(`timeline.${item.id}.period`);
const isPlaceholderPeriod = /^\[.*\]$/.test(period);
---

<li
  class:list={['timeline__item', item.highlighted && 'timeline__item--highlighted']}
  data-reveal
  style={`--reveal-delay: ${Math.min(index, 5) * 70}ms`}
>
  <span class="timeline__marker" aria-hidden="true">
    <Icon name={iconByType[item.type]} size={16} />
  </span>

  <div class="timeline__content">
    <div class="timeline__meta">
      <span
        class:list={['timeline__period', isPlaceholderPeriod && 'timeline__period--pending']}
        data-i18n={`timeline.${item.id}.period`}
      >
        {period}
      </span>
      <span class="tag" data-i18n={`journey.types.${item.type}`}>{t(`journey.types.${item.type}`)}</span>
    </div>

    <h3 class="timeline__title" data-i18n={`timeline.${item.id}.title`}>
      {t(`timeline.${item.id}.title`)}
    </h3>

    {item.organization && <p class="timeline__org">{item.organization}</p>}

    <p class="muted" data-i18n={`timeline.${item.id}.description`}>
      {t(`timeline.${item.id}.description`)}
    </p>
  </div>
</li>

<style>
  .timeline__item {
    position: relative;
    display: flex;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
  }

  .timeline__item:last-child {
    padding-bottom: 0;
  }

  .timeline__marker {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: 50%;
    color: var(--color-text-muted);
    z-index: 1;
  }

  .timeline__item--highlighted .timeline__marker {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }

  .timeline__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-bottom: var(--space-2);
  }

  .timeline__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .timeline__period {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-primary-ink);
  }

  .timeline__period--pending {
    color: var(--color-text-muted);
    border-bottom: 2px dashed var(--color-secondary);
  }

  .timeline__title {
    font-size: var(--text-lg);
  }

  .timeline__org {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .timeline__item p:last-child {
    font-size: var(--text-sm);
    max-width: 62ch;
  }
</style>
