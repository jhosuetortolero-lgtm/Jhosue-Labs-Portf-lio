---
import Icon from '../common/Icon.astro';
import { useTranslations } from '../../i18n';
import { DEFAULT_LANGUAGE } from '../../types/i18n';
import { withBase } from '../../utils/paths';
import type { Project, ProjectCategory } from '../../types/project';

export interface Props {
  project: Project;
  index?: number;
  /** true nas cópias usadas para o loop do carrossel. */
  clone?: boolean;
}

const { project, index = 0, clone = false } = Astro.props;
const t = useTranslations(DEFAULT_LANGUAGE);

const statusKey = `projects.status.${project.status}`;
const categoryKey = `projects.category.${project.category}`;

/** Ícone que representa a categoria no cartão sem imagem. */
const categoryIcon: Record<Exclude<ProjectCategory, 'ALL'>, string> = {
  WEB: 'code',
  SAAS: 'layers',
  AI: 'sparkles',
  AUTOMATION: 'workflow',
  CRM: 'chat',
  API: 'plug',
  MOBILE: 'command',
};

/** Iniciais usadas no cartão gerado quando não há imagem. */
const initials = project.title
  .split(/\s+/)
  .slice(0, 2)
  .map((word) => word.charAt(0).toUpperCase())
  .join('');

/** Mostra as 4 primeiras tecnologias e resume o resto. */
const VISIBLE_TECH = 4;
const shownTech = project.technologies.slice(0, VISIBLE_TECH);
const extraTech = project.technologies.length - shownTech.length;

const hasLink = Boolean(project.projectUrl);
---

<li
  class="project"
  data-project
  data-carousel-item
  data-category={project.category}
  data-project-clone={clone ? 'true' : undefined}
  data-reveal={clone ? undefined : true}
  aria-hidden={clone ? 'true' : undefined}
  style={`--reveal-delay: ${Math.min(index, 5) * 70}ms`}
>
  <article class="project__inner">
    <span class="project__bar" aria-hidden="true"></span>

    <div class="project__media">
      {
        project.image ? (
          <img
            src={withBase(project.image)}
            alt={t(`project.${project.id}.imageAlt`)}
            data-i18n-attr={`alt:project.${project.id}.imageAlt`}
            width="640"
            height="360"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="project__placeholder" aria-hidden="true">
            <span class="project__glow"></span>
            <span class="project__grid"></span>
            <span class="project__initials">{initials}</span>
            <span class="project__badge-icon">
              <Icon name={categoryIcon[project.category] ?? 'code'} size={18} />
            </span>
          </div>
        )
      }

      <span class="project__chips">
        <span class={`chip chip--${project.category.toLowerCase()}`} data-i18n={categoryKey}>
          {t(categoryKey)}
        </span>
        {
          project.featured && (
            <span class="chip chip--featured" data-i18n="projects.featured">
              {t('projects.featured')}
            </span>
          )
        }
      </span>

      {project.year && <span class="project__year">{project.year}</span>}
    </div>

    <div class="project__body">
      <div class="project__title-row">
        <h3 class="project__title">{project.title}</h3>
        <span class={`project__status project__status--${project.status}`}>
          <span class="project__status-dot" aria-hidden="true"></span>
          <span data-i18n={statusKey}>{t(statusKey)}</span>
        </span>
      </div>

      <p class="project__text muted" data-i18n={`project.${project.id}.short`}>
        {t(`project.${project.id}.short`)}
      </p>

      <ul class="project__tech" role="list">
        {shownTech.map((tech) => <li>{tech}</li>)}
        {extraTech > 0 && <li class="project__tech-more">+{extraTech}</li>}
      </ul>

      <div class="project__actions">
        {
          project.projectUrl && (
            <a
              href={project.projectUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="project__action project__action--primary"
              tabindex={clone ? -1 : 0}
            >
              <span data-i18n="projects.visit">{t('projects.visit')}</span>
              <Icon name="arrow-right" size={15} />
              <span class="visually-hidden" data-i18n="a11y.externalLink">
                {t('a11y.externalLink')}
              </span>
            </a>
          )
        }
        {
          project.repositoryUrl && (
            <a
              href={project.repositoryUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="project__action"
              tabindex={clone ? -1 : 0}
              aria-label={`${t('projects.repository')} — ${project.title}`}
            >
              <Icon name="github" size={16} />
              <span class="visually-hidden">{t('projects.repository')}</span>
            </a>
          )
        }
        {
          !hasLink && !project.repositoryUrl && (
            <span class="project__action project__action--locked">
              <Icon name="lock" size={15} />
              <span data-i18n="projects.status.private">{t('projects.status.private')}</span>
            </span>
          )
        }
      </div>
    </div>
  </article>
</li>

<style>
  .project {
    display: flex;
    list-style: none;
  }

  .project[hidden] {
    display: none;
  }

  .project__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-large);
    box-shadow: var(--shadow-small);
    overflow: hidden;
    transition:
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .project__inner:hover,
  .project__inner:focus-within {
    transform: translate(-4px, -4px);
    box-shadow: var(--shadow-medium);
  }

  /* Barra que corre no topo ao passar o mouse. */
  .project__bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    z-index: 3;
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .project__inner:hover .project__bar,
  .project__inner:focus-within .project__bar {
    transform: scaleX(1);
  }

  /* --- Mídia -------------------------------------------------------------- */

  .project__media {
    position: relative;
    aspect-ratio: 16 / 10;
    border-bottom: var(--border-width) solid var(--color-border);
    background-color: var(--color-surface-secondary);
    overflow: hidden;
  }

  .project__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .project__inner:hover .project__media img {
    transform: scale(1.04);
  }

  .project__placeholder {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background-color: var(--terminal-bg);
  }

  /* Brilho que acompanha a categoria. */
  .project__glow {
    position: absolute;
    inset: -30%;
    background: radial-gradient(
      circle at 32% 28%,
      color-mix(in srgb, var(--chip-color, var(--color-primary)) 45%, transparent),
      transparent 62%
    );
    opacity: 0.55;
    transition: opacity var(--duration-slow) var(--ease-out);
  }

  .project__inner:hover .project__glow {
    opacity: 0.8;
  }

  .project__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 6%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 6%) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 75% 75% at 50% 50%, #000 35%, transparent 100%);
  }

  .project__initials {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 7vw, 4rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #f2f7f3;
    text-shadow: 0 6px 24px rgb(0 0 0 / 45%);
  }

  .project__badge-icon {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    z-index: 1;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-medium);
    background-color: rgb(255 255 255 / 12%);
    border: 1px solid rgb(255 255 255 / 22%);
    color: #f2f7f3;
    backdrop-filter: blur(4px);
  }

  /* --- Chips -------------------------------------------------------------- */

  .project__chips {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chip {
    padding: 0.2rem 0.65rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(0 0 0 / 25%);
    background-color: var(--chip-color, var(--color-primary));
    color: var(--color-on-primary);
    white-space: nowrap;
  }

  .chip--featured {
    background-color: var(--color-text);
    color: var(--color-background);
    border-color: transparent;
  }

  /* Cada categoria com sua cor. */
  .project[data-category='WEB'] {
    --chip-color: #21c07a;
  }
  .project[data-category='SAAS'] {
    --chip-color: #6b4bff;
  }
  .project[data-category='AI'] {
    --chip-color: #ff6a3d;
  }
  .project[data-category='AUTOMATION'] {
    --chip-color: #12a5c9;
  }
  .project[data-category='CRM'] {
    --chip-color: #e05c9c;
  }
  .project[data-category='API'] {
    --chip-color: #f5a623;
  }
  .project[data-category='MOBILE'] {
    --chip-color: #5b7cfa;
  }

  .project__year {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    z-index: 2;
    padding: 0.15rem 0.55rem;
    font-size: var(--text-xs);
    font-weight: 700;
    border-radius: var(--radius-pill);
    background-color: rgb(0 0 0 / 55%);
    color: #f2f7f3;
    backdrop-filter: blur(4px);
  }

  /* --- Corpo -------------------------------------------------------------- */

  .project__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    flex: 1;
  }

  .project__title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .project__title {
    font-size: var(--text-xl);
    line-height: 1.2;
  }

  .project__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    flex-shrink: 0;
    padding-top: 0.25rem;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .project__status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--color-text-muted);
  }

  .project__status--online .project__status-dot {
    background-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-soft);
  }

  .project__status--development .project__status-dot {
    background-color: var(--color-warning);
  }

  .project__text {
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .project__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project__tech li {
    padding: 0.15rem 0.55rem;
    font-size: var(--text-xs);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-small);
    color: var(--color-text-muted);
  }

  .project__tech-more {
    background-color: var(--color-surface-secondary);
    font-weight: 700;
  }

  .project__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-soft);
  }

  .project__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 44px;
    padding-inline: 0.9rem;
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    border: var(--border-width) solid var(--color-border-soft);
    border-radius: var(--radius-medium);
    color: var(--color-text);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .project__action:hover {
    border-color: var(--color-border);
    background-color: var(--color-surface-secondary);
  }

  .project__action--primary {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    border-color: var(--color-border);
  }

  .project__action--primary:hover {
    background-color: var(--color-primary);
    transform: translateX(2px);
  }

  /* Botão só de ícone (repositório): quadrado. */
  .project__action[aria-label] {
    width: 44px;
    padding-inline: 0;
  }

  .project__action--locked {
    color: var(--color-text-muted);
    cursor: default;
    border-style: dashed;
  }

  @media (prefers-reduced-motion: reduce) {
    .project__inner:hover,
    .project__inner:focus-within,
    .project__action--primary:hover {
      transform: none;
    }

    .project__inner:hover .project__media img {
      transform: none;
    }
  }
</style>
