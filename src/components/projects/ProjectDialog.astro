---
import Icon from '../common/Icon.astro';
import { projects } from '../../data/projects';
import { useTranslations } from '../../i18n';
import { DEFAULT_LANGUAGE } from '../../types/i18n';
import { withBase } from '../../utils/paths';

const t = useTranslations(DEFAULT_LANGUAGE);
---

<div class="pdialog" data-project-dialog hidden>
  <div class="pdialog__backdrop" data-project-backdrop></div>

  <div
    class="pdialog__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="project-dialog-title"
    data-project-panel
  >
    <div class="pdialog__head">
      <h2 id="project-dialog-title" class="pdialog__title" data-project-dialog-title></h2>
      <button
        type="button"
        class="pdialog__close touch-target"
        data-project-close
        aria-label={t('projects.close')}
        data-i18n-attr="aria-label:projects.close"
      >
        <Icon name="close" size={22} />
      </button>
    </div>

    <div class="pdialog__body">
      {
        projects.map((project) => {
          const categoryKey = `projects.category.${project.category}`;
          const statusKey = `projects.status.${project.status}`;
          // Sem descrição completa, o diálogo repete o resumo do cartão.
          const descriptionKey = project.fullDescription
            ? `project.${project.id}.full`
            : `project.${project.id}.short`;

          return (
            <article
              class="pdialog__item"
              data-project-item={project.id}
              data-project-title={project.title}
              data-category={project.category}
              hidden
            >
              {project.image && (
                <img
                  class="pdialog__image"
                  src={withBase(project.image)}
                  alt={t(`project.${project.id}.imageAlt`)}
                  data-i18n-attr={`alt:project.${project.id}.imageAlt`}
                  width="640"
                  height="400"
                  loading="lazy"
                  decoding="async"
                />
              )}

              <div class="pdialog__meta">
                <span class="pdialog__chip" data-i18n={categoryKey}>
                  {t(categoryKey)}
                </span>
                {project.year && <span class="tag">{project.year}</span>}
                <span class={`pdialog__status pdialog__status--${project.status}`}>
                  <span class="pdialog__status-dot" aria-hidden="true" />
                  <span data-i18n={statusKey}>{t(statusKey)}</span>
                </span>
              </div>

              <p class="pdialog__text" data-i18n={descriptionKey}>
                {t(descriptionKey)}
              </p>

              <h3 class="mono-label" data-i18n="projects.technologies">
                {t('projects.technologies')}
              </h3>
              <ul class="pdialog__tech" role="list">
                {project.technologies.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>

              {(project.projectUrl || project.repositoryUrl) && (
                <div class="pdialog__actions">
                  {project.projectUrl && (
                    <a
                      href={project.projectUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="pdialog__action pdialog__action--primary"
                    >
                      <span data-i18n="projects.visit">{t('projects.visit')}</span>
                      <Icon name="arrow-right" size={15} />
                      <span class="visually-hidden" data-i18n="a11y.externalLink">
                        {t('a11y.externalLink')}
                      </span>
                    </a>
                  )}
                  {project.repositoryUrl && (
                    <a
                      href={project.repositoryUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="pdialog__action"
                    >
                      <Icon name="github" size={16} />
                      <span data-i18n="projects.repository">{t('projects.repository')}</span>
                    </a>
                  )}
                </div>
              )}
            </article>
          );
        })
      }
    </div>
  </div>
</div>

<style>
  .pdialog {
    position: fixed;
    inset: 0;
    z-index: var(--z-palette);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(0.75rem, 3vw, 2rem);
  }

  .pdialog[hidden] {
    display: none;
  }

  .pdialog__backdrop {
    position: absolute;
    inset: 0;
    background-color: rgb(0 0 0 / 72%);
    backdrop-filter: blur(4px);
  }

  .pdialog__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    width: min(100%, 46rem);
    max-height: 92svh;
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-medium);
    box-shadow: var(--shadow-large);
    overflow: hidden;
    animation: fade-up 200ms var(--ease-out);
  }

  .pdialog__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .pdialog__title {
    flex: 1;
    min-width: 0;
    font-size: var(--text-xl);
    line-height: 1.2;
  }

  .pdialog__close {
    flex-shrink: 0;
    border: var(--border-width) solid var(--color-border-soft);
    border-radius: var(--radius-medium);
    color: var(--color-text);
  }

  .pdialog__close:hover {
    border-color: var(--color-border);
    background-color: var(--color-surface-secondary);
  }

  .pdialog__body {
    padding: var(--space-5);
    overflow-y: auto;
  }

  .pdialog__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .pdialog__item[hidden] {
    display: none;
  }

  .pdialog__image {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-small);
    background-color: var(--color-surface-secondary);
  }

  .pdialog__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .pdialog__chip {
    padding: 0.2rem 0.65rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(0 0 0 / 25%);
    background-color: var(--chip-color, var(--color-primary));
    color: var(--color-on-primary);
  }

  /* Mesmas cores de categoria do cartão. */
  .pdialog__item[data-category='WEB'] {
    --chip-color: #21c07a;
  }
  .pdialog__item[data-category='SAAS'] {
    --chip-color: #6b4bff;
  }
  .pdialog__item[data-category='AI'] {
    --chip-color: #ff6a3d;
  }
  .pdialog__item[data-category='AUTOMATION'] {
    --chip-color: #12a5c9;
  }
  .pdialog__item[data-category='CRM'] {
    --chip-color: #e05c9c;
  }
  .pdialog__item[data-category='API'] {
    --chip-color: #f5a623;
  }
  .pdialog__item[data-category='MOBILE'] {
    --chip-color: #5b7cfa;
  }

  .pdialog__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-left: auto;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .pdialog__status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--color-text-muted);
  }

  .pdialog__status--online .pdialog__status-dot {
    background-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-soft);
  }

  .pdialog__status--development .pdialog__status-dot {
    background-color: var(--color-warning);
  }

  .pdialog__text {
    font-size: var(--text-base);
    line-height: 1.7;
  }

  .pdialog__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: calc(var(--space-2) * -1) 0 0;
    padding: 0;
    list-style: none;
  }

  .pdialog__tech li {
    padding: 0.15rem 0.55rem;
    font-size: var(--text-xs);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-small);
    color: var(--color-text-muted);
  }

  .pdialog__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-soft);
  }

  .pdialog__action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding-inline: 0.9rem;
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    border: var(--border-width) solid var(--color-border-soft);
    border-radius: var(--radius-medium);
    color: var(--color-text);
  }

  .pdialog__action:hover {
    border-color: var(--color-border);
    background-color: var(--color-surface-secondary);
  }

  .pdialog__action--primary,
  .pdialog__action--primary:hover {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    border-color: var(--color-border);
  }

  @media (prefers-reduced-motion: reduce) {
    .pdialog__panel {
      animation: none;
    }
  }
</style>
