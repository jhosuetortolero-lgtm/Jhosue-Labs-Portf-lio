---
import Icon from '../common/Icon.astro';
import CertificateCard from './CertificateCard.astro';
import { certificates } from '../../data/certificates';
import { useTranslations } from '../../i18n';
import { DEFAULT_LANGUAGE } from '../../types/i18n';

const t = useTranslations(DEFAULT_LANGUAGE);

/**
 * A lista é renderizada duas vezes: a segunda cópia é só visual, para o
 * carrossel emendar sem salto. As cópias saem da árvore de acessibilidade
 * e da ordem de tabulação.
 */
const hasCertificates = certificates.length > 0;
---

{
  hasCertificates ? (
    <div
      class="carousel"
      data-carousel
      data-carousel-pause-key="certificates.pause"
      data-carousel-play-key="certificates.play"
      role="group"
      aria-roledescription="carousel"
      aria-label={t('certificates.carousel')}
      data-i18n-attr="aria-label:certificates.carousel"
    >
      <div class="carousel__viewport" data-carousel-viewport tabindex="0">
        <ul class="carousel__track" data-carousel-track>
          {certificates.map((certificate, index) => (
            <CertificateCard certificate={certificate} index={index} />
          ))}
          {certificates.map((certificate, index) => (
            <CertificateCard certificate={certificate} index={index} clone />
          ))}
        </ul>
      </div>

      <div class="carousel__controls">
        <button
          type="button"
          class="carousel__button touch-target"
          data-carousel-prev
          aria-label={t('certificates.previous')}
          data-i18n-attr="aria-label:certificates.previous"
        >
          <Icon name="arrow-right" size={18} />
        </button>

        <button
          type="button"
          class="carousel__button touch-target"
          data-carousel-toggle
          aria-pressed="false"
          aria-label={t('certificates.pause')}
          data-i18n-attr="aria-label:certificates.pause"
        >
          <span data-carousel-toggle-icon class="carousel__bars" aria-hidden="true" />
        </button>

        <button
          type="button"
          class="carousel__button touch-target"
          data-carousel-next
          aria-label={t('certificates.next')}
          data-i18n-attr="aria-label:certificates.next"
        >
          <Icon name="arrow-right" size={18} />
        </button>
      </div>
    </div>
  ) : (
    <p class="carousel__empty muted" data-i18n="certificates.empty">
      {t('certificates.empty')}
    </p>
  )
}

<style>
  .carousel {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .carousel__viewport {
    overflow-x: auto;
    overflow-y: hidden;
    /* Sem barra visível: a navegação é pelos botões, teclado e arrasto. */
    scrollbar-width: none;
    padding-block: var(--space-2);
    /* Espaço para a sombra dos cartões não ser cortada. */
    padding-inline: 4px;
    margin-inline: -4px;
  }

  .carousel__viewport::-webkit-scrollbar {
    display: none;
  }

  .carousel__viewport:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 4px;
    border-radius: var(--radius-medium);
  }

  .carousel__track {
    display: flex;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    width: max-content;
  }

  .carousel__controls {
    display: flex;
    gap: var(--space-2);
  }

  .carousel__button {
    width: 44px;
    height: 44px;
    border: var(--border-width) solid var(--color-border-soft);
    border-radius: var(--radius-medium);
    background-color: var(--color-surface);
    color: var(--color-text);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .carousel__button:hover {
    border-color: var(--color-border);
    background-color: var(--color-surface-secondary);
  }

  /* :global porque o SVG vem de dentro do componente Icon. */
  [data-carousel-prev] :global(svg) {
    transform: rotate(180deg);
  }

  /* Ícone de pausa (duas barras) que vira "play" quando pausado. */
  .carousel__bars {
    display: block;
    width: 14px;
    height: 14px;
    border-left: 4px solid currentColor;
    border-right: 4px solid currentColor;
  }

  [data-carousel-toggle][aria-pressed='true'] .carousel__bars {
    width: 0;
    height: 0;
    border-left: 12px solid currentColor;
    border-right: 0;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
  }

  .carousel__empty {
    padding: var(--space-5);
    text-align: center;
    border: 2px dashed var(--color-border-soft);
    border-radius: var(--radius-medium);
  }
</style>
