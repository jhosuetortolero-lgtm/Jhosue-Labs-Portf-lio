---
import Icon from '../common/Icon.astro';
import { listedCommands } from '../../data/terminalCommands';
import { useTranslations } from '../../i18n';
import { DEFAULT_LANGUAGE } from '../../types/i18n';
import { siteConfig } from '../../config/site';

const t = useTranslations(DEFAULT_LANGUAGE);
---

<div class="palette" id="command-palette" hidden data-palette>
  <div class="palette__backdrop" data-palette-backdrop></div>

  <div
    class="palette__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="palette-title"
    aria-describedby="palette-description"
    data-palette-dialog
  >
    <div class="palette__head">
      <h2 id="palette-title" class="palette__title" data-i18n="palette.title">
        {t('palette.title')}
      </h2>
      <span class="mono-label">{siteConfig.brand.name}</span>
      <button
        type="button"
        class="palette__close touch-target"
        data-palette-close
        aria-label={t('palette.close')}
        data-i18n-attr="aria-label:palette.close"
      >
        <Icon name="close" size={20} />
      </button>
    </div>

    <p id="palette-description" class="visually-hidden" data-i18n="palette.description">
      {t('palette.description')}
    </p>

    <div class="palette__input-row">
      <span class="palette__prompt" aria-hidden="true">$</span>
      <input
        type="text"
        class="palette__input"
        data-palette-input
        placeholder={t('palette.placeholder')}
        data-i18n-attr="placeholder:palette.placeholder"
        aria-label={t('palette.placeholder')}
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        maxlength="60"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-list"
        aria-autocomplete="list"
      />
    </div>

    <ul class="palette__list" id="palette-list" role="listbox" data-palette-list>
      {
        listedCommands.map((command, index) => (
          <li
            class="palette__item"
            role="option"
            id={`palette-option-${index}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            data-palette-item={command.name}
          >
            <span class="palette__command">{command.name}</span>
            <span class="palette__description" data-i18n={command.descriptionKey}>
              {t(command.descriptionKey)}
            </span>
          </li>
        ))
      }
    </ul>

    <p class="palette__empty" data-palette-empty hidden data-i18n="palette.noResults">
      {t('palette.noResults')}
    </p>

    <div
      class="palette__output"
      data-palette-output
      role="log"
      aria-live="polite"
      aria-label={t('palette.outputLabel')}
      data-i18n-attr={`aria-label:palette.outputLabel`}
    >
    </div>
  </div>
</div>

<style>
  .palette {
    position: fixed;
    inset: 0;
    z-index: var(--z-palette);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(1rem, 6vh, 5rem) var(--space-4) var(--space-4);
  }

  .palette[hidden] {
    display: none;
  }

  .palette__backdrop {
    position: absolute;
    inset: 0;
    background-color: rgb(0 0 0 / 55%);
    backdrop-filter: blur(3px);
  }

  .palette__dialog {
    position: relative;
    display: flex;
    flex-direction: column;
    width: min(100%, 40rem);
    max-height: min(80vh, 40rem);
    background-color: var(--terminal-bg);
    color: var(--terminal-text);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-medium);
    box-shadow: var(--shadow-large);
    overflow: hidden;
    animation: fade-up 180ms var(--ease-out);
  }

  .palette__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid rgb(255 255 255 / 12%);
  }

  .palette__title {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--terminal-prompt);
  }

  .palette__head .mono-label {
    margin-left: auto;
    color: rgb(255 255 255 / 45%);
  }

  .palette__close {
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    border-radius: var(--radius-small);
    color: rgb(255 255 255 / 70%);
  }

  .palette__close:hover {
    background-color: rgb(255 255 255 / 12%);
    color: #fff;
  }

  .palette__input-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.8rem 0.9rem;
    border-bottom: 1px solid rgb(255 255 255 / 12%);
  }

  .palette__prompt {
    color: var(--terminal-prompt);
    font-weight: 700;
  }

  .palette__input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    color: var(--terminal-text);
    font-family: var(--font-body);
    font-size: var(--text-sm);
  }

  .palette__input::placeholder {
    color: rgb(255 255 255 / 40%);
  }

  .palette__input:focus-visible {
    outline: 2px solid var(--terminal-prompt);
    outline-offset: 2px;
    border-radius: var(--radius-small);
  }

  .palette__list {
    flex: 1;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    overflow-y: auto;
    min-height: 0;
  }

  .palette__item {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-small);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .palette__item[hidden] {
    display: none;
  }

  .palette__item[aria-selected='true'] {
    background-color: rgb(255 255 255 / 10%);
    outline: 1px solid var(--terminal-prompt);
  }

  .palette__command {
    color: var(--terminal-accent);
    font-weight: 700;
    white-space: nowrap;
  }

  .palette__description {
    color: rgb(255 255 255 / 60%);
    font-size: var(--text-xs);
    margin-left: auto;
    text-align: right;
  }

  .palette__empty {
    padding: var(--space-4);
    text-align: center;
    color: rgb(255 255 255 / 55%);
    font-size: var(--text-sm);
  }

  .palette__empty[hidden] {
    display: none;
  }

  .palette__output {
    max-height: 12rem;
    overflow-y: auto;
    padding: 0 0.9rem;
    font-size: var(--text-xs);
    line-height: 1.7;
    white-space: pre-wrap;
    color: rgb(255 255 255 / 78%);
    border-top: 1px solid transparent;
  }

  .palette__output:not(:empty) {
    padding-block: 0.7rem;
    border-top-color: rgb(255 255 255 / 12%);
  }

  @media (max-width: 560px) {
    .palette {
      padding: var(--space-3);
    }

    .palette__dialog {
      max-height: 88vh;
    }

    .palette__item {
      flex-direction: column;
      gap: 0.15rem;
    }

    .palette__description {
      margin-left: 0;
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .palette__dialog {
      animation: none;
    }
  }
</style>
