---
import Icon from '../common/Icon.astro';
import Stars from './Stars.astro';
import { testimonials } from '../../data/testimonials';
import { useTranslations } from '../../i18n';
import { DEFAULT_LANGUAGE } from '../../types/i18n';
import { withBase } from '../../utils/paths';

const t = useTranslations(DEFAULT_LANGUAGE);
const total = testimonials.length;
---

<div class="tdialog" data-testimonial-dialog hidden>
  <div class="tdialog__backdrop" data-testimonial-backdrop></div>

  <div
    class="tdialog__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="testimonial-title"
    data-testimonial-panel
  >
    <div class="tdialog__head">
      <h2 id="testimonial-title" class="tdialog__title" data-testimonial-author></h2>
      <p class="tdialog__counter" aria-live="polite">
        <span data-testimonial-index>1</span>
        <span data-i18n="certificates.of">{t('certificates.of')}</span>
        <span>{total}</span>
      </p>
      <button
        type="button"
        class="tdialog__close touch-target"
        data-testimonial-close
        aria-label={t('testimonials.close')}
        data-i18n-attr="aria-label:testimonials.close"
      >
        <Icon name="close" size={22} />
      </button>
    </div>

    <div class="tdialog__body">
      {
        testimonials.map((testimonial, index) => (
          <article class="tdialog__item" data-testimonial-item={index} hidden>
            <div class="tdialog__meta">
              {testimonial.rating !== null && (
                <Stars rating={testimonial.rating} label={t('testimonials.rating')} size={17} />
              )}
              <span class="tag">{testimonial.source}</span>
              <span class="mono-label">{testimonial.period}</span>
            </div>

            <p class="tdialog__project">{testimonial.project}</p>

            <blockquote class="tdialog__quote">
              <p>{testimonial.quote}</p>
              <footer>
                <cite>
                  {testimonial.author}
                  {testimonial.company ? ` — ${testimonial.company}` : ''}
                </cite>
              </footer>
            </blockquote>

            {testimonial.proofImage && (
              <figure class="tdialog__proof">
                <figcaption class="mono-label" data-i18n="testimonials.proof">
                  {t('testimonials.proof')}
                </figcaption>
                <img
                  src={withBase(testimonial.proofImage)}
                  alt={`${t('testimonials.proofAlt')} ${testimonial.author} — ${testimonial.source}`}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            )}

            {testimonial.sourceUrl && (
              <a
                class="tdialog__link"
                href={testimonial.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name="external" size={15} />
                <span data-i18n="testimonials.viewSource">{t('testimonials.viewSource')}</span>
              </a>
            )}
          </article>
        ))
      }
    </div>

    {
      total > 1 && (
        <div class="tdialog__nav">
          <button
            type="button"
            class="tdialog__navButton touch-target"
            data-testimonial-prev
            aria-label={t('testimonials.previous')}
            data-i18n-attr="aria-label:testimonials.previous"
          >
            <Icon name="arrow-right" size={18} />
          </button>
          <button
            type="button"
            class="tdialog__navButton touch-target"
            data-testimonial-next
            aria-label={t('testimonials.next')}
            data-i18n-attr="aria-label:testimonials.next"
          >
            <Icon name="arrow-right" size={18} />
          </button>
        </div>
      )
    }
  </div>
</div>

<style>
  .tdialog {
    position: fixed;
    inset: 0;
    z-index: var(--z-palette);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(0.75rem, 3vw, 2rem);
  }

  .tdialog[hidden] {
    display: none;
  }

  .tdialog__backdrop {
    position: absolute;
    inset: 0;
    background-color: rgb(0 0 0 / 72%);
    backdrop-filter: blur(4px);
  }

  .tdialog__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    width: min(100%, 44rem);
    max-height: 92svh;
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-medium);
    box-shadow: var(--shadow-large);
    overflow: hidden;
    animation: fade-up 200ms var(--ease-out);
  }

  .tdialog__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .tdialog__title {
    flex: 1;
    min-width: 0;
    font-size: var(--text-lg);
  }

  .tdialog__counter {
    display: flex;
    gap: 0.4ch;
    flex-shrink: 0;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .tdialog__close {
    flex-shrink: 0;
    border: var(--border-width) solid var(--color-border-soft);
    border-radius: var(--radius-medium);
    color: var(--color-text);
  }

  .tdialog__close:hover {
    border-color: var(--color-border);
    background-color: var(--color-surface-secondary);
  }

  .tdialog__body {
    padding: var(--space-5);
    overflow-y: auto;
  }

  .tdialog__item[hidden] {
    display: none;
  }

  .tdialog__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .tdialog__project {
    font-weight: 700;
    margin-bottom: var(--space-4);
  }

  .tdialog__quote {
    margin: 0;
    padding-left: var(--space-4);
    border-left: 3px solid var(--color-primary);
  }

  .tdialog__quote p {
    font-size: var(--text-lg);
    line-height: 1.65;
  }

  .tdialog__quote footer {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .tdialog__quote cite {
    font-style: normal;
    font-weight: 700;
  }

  .tdialog__proof {
    margin: var(--space-5) 0 0;
  }

  .tdialog__proof figcaption {
    margin-bottom: var(--space-2);
  }

  .tdialog__proof img {
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-small);
    background-color: #fff;
  }

  .tdialog__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary-ink);
  }

  .tdialog__nav {
    display: flex;
    gap: var(--space-2);
    padding: var(--space-4);
    border-top: 1px solid var(--color-border-soft);
  }

  .tdialog__navButton {
    width: 44px;
    height: 44px;
    border: var(--border-width) solid var(--color-border-soft);
    border-radius: var(--radius-medium);
    color: var(--color-text);
  }

  .tdialog__navButton:hover {
    border-color: var(--color-border);
    background-color: var(--color-surface-secondary);
  }

  [data-testimonial-prev] :global(svg) {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .tdialog__panel {
      animation: none;
    }
  }
</style>
