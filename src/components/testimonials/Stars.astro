---
/**
 * Nota em estrelas. A nota também vai em texto, para não depender só do
 * desenho — e o conjunto tem um rótulo acessível único.
 */
export interface Props {
  rating: number;
  label: string;
  size?: number;
}

const { rating, label, size = 15 } = Astro.props;
const cheias = Math.round(rating);
const estrelas = [1, 2, 3, 4, 5];
---

<span class="stars" role="img" aria-label={`${label}: ${rating.toFixed(1)} / 5`}>
  <span class="stars__icons" aria-hidden="true">
    {
      estrelas.map((posicao) => (
        <svg
          class:list={['stars__star', posicao <= cheias && 'stars__star--on']}
          width={size}
          height={size}
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
        >
          <path d="m12 3 2.7 5.9 6.3.7-4.7 4.3 1.3 6.4L12 17.1 6.4 20.3l1.3-6.4L3 9.6l6.3-.7L12 3Z" />
        </svg>
      ))
    }
  </span>
  <span class="stars__value" aria-hidden="true">{rating.toFixed(1)}</span>
</span>

<style>
  .stars {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .stars__icons {
    display: inline-flex;
    gap: 1px;
  }

  .stars__star {
    color: var(--color-border-soft);
  }

  .stars__star--on {
    color: #f5a623;
    fill: #f5a623;
  }

  .stars__value {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-muted);
  }
</style>
