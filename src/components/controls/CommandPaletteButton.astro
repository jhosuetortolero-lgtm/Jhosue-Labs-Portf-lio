---
import Icon from '../common/Icon.astro';
import { useTranslations } from '../../i18n';
import { DEFAULT_LANGUAGE } from '../../types/i18n';

const t = useTranslations(DEFAULT_LANGUAGE);
---

<button
  type="button"
  class="palette-button touch-target"
  data-palette-open
  aria-label={t('a11y.openPalette')}
  data-i18n-attr="aria-label:a11y.openPalette"
  aria-haspopup="dialog"
  aria-controls="command-palette"
>
  <Icon name="terminal" size={18} />
  <span class="palette-button__label" data-i18n="palette.open">{t('palette.open')}</span>
  <kbd class="palette-button__hint">Ctrl K</kbd>
</button>

<style>
  .palette-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding-inline: 0.75rem;
    border: var(--border-width) solid var(--color-border-soft);
    border-radius: var(--radius-medium);
    background-color: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-sm);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .palette-button:hover {
    border-color: var(--color-border);
    background-color: var(--color-surface-secondary);
  }

  .palette-button__hint {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-small);
    color: var(--color-text-muted);
  }

  @media (max-width: 1100px) {
    .palette-button__label,
    .palette-button__hint {
      display: none;
    }

    .palette-button {
      width: 44px;
      padding-inline: 0;
      justify-content: center;
    }
  }
</style>
