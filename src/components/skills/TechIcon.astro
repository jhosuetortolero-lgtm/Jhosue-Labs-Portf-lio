---
import { techIconPaths } from './techIcons';

/**
 * Ícone de uma tecnologia. Se não houver desenho para o id, não renderiza
 * nada — a grade cai no selo com as iniciais.
 */
export interface Props {
  id: string;
  size?: number;
  strokeWidth?: number;
}

const { id, size = 22, strokeWidth = 1.6 } = Astro.props;
const paths = techIconPaths[id] ?? null;
---

{
  paths && (
    <svg
      class="tech-icon"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
      role="presentation"
      aria-hidden="true"
      focusable="false"
    >
      {paths.map((d) => (
        <path d={d} />
      ))}
    </svg>
  )
}

<style>
  .tech-icon {
    display: block;
  }
</style>
