---
import { getTechIcon } from './techIcons';

/**
 * Icone de uma tecnologia. Marcas reais saem preenchidas (logotipo oficial);
 * desenhos proprios saem em traco. A cor vem do `currentColor`, definido pelo
 * selo em TechnologyGrid a partir de `--brand`.
 *
 * Se nao houver desenho para o id, nao renderiza nada — a grade cai no selo
 * com as iniciais.
 */
export interface Props {
  id: string;
  size?: number;
  strokeWidth?: number;
}

const { id, size = 22, strokeWidth = 1.6 } = Astro.props;
const icon = getTechIcon(id);
const isBrand = icon?.kind === 'brand';
---

{
  icon && (
    <svg
      class="tech-icon"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill={isBrand ? 'currentColor' : 'none'}
      stroke={isBrand ? 'none' : 'currentColor'}
      stroke-width={isBrand ? undefined : strokeWidth}
      stroke-linecap={isBrand ? undefined : 'round'}
      stroke-linejoin={isBrand ? undefined : 'round'}
      role="presentation"
      aria-hidden="true"
      focusable="false"
    >
      {icon.paths.map((d) => (
        <path d={d} />
      ))}
    </svg>
  )
}

<style>
  .tech-icon {
    display: block;
  }
</style>
