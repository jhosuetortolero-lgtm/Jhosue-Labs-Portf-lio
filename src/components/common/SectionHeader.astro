---
export interface Props {
  eyebrowKey: string;
  titleKey: string;
  subtitleKey?: string;
  eyebrow: string;
  title: string;
  subtitle?: string;
  headingId?: string;
}

const { eyebrowKey, titleKey, subtitleKey, eyebrow, title, subtitle, headingId } = Astro.props;
---

<header class="section-header" data-reveal>
  <p class="eyebrow" data-i18n={eyebrowKey}>{eyebrow}</p>
  <h2 id={headingId} data-i18n={titleKey}>{title}</h2>
  {subtitle && subtitleKey && (
    <p class="lead" data-i18n={subtitleKey}>{subtitle}</p>
  )}
</header>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
    max-width: 68ch;
  }
</style>
