---
import Icon from './Icon.astro';
import { siteConfig } from '../../config/site';
import { useTranslations } from '../../i18n';
import { DEFAULT_LANGUAGE } from '../../types/i18n';
import { withBase } from '../../utils/paths';

/**
 * Vídeo de destaque com moldura tecnológica.
 * Mudo, em loop e inline (toca no celular sem abrir em tela cheia). Quem dá
 * o play é src/scripts/heroVideo.ts; sem JavaScript fica o pôster, que é o
 * primeiro quadro do vídeo.
 * A moldura herda a proporção do vídeo: ele aparece inteiro, sem recorte.
 */
const t = useTranslations(DEFAULT_LANGUAGE);
const { video, availability, brand } = siteConfig;

const available = availability.open;
---

<figure class="photo">
  <div class="photo__frame" style={`aspect-ratio: ${video.width} / ${video.height}`}>
    <video
      class="photo__video"
      width={video.width}
      height={video.height}
      poster={withBase(video.poster)}
      preload="metadata"
      muted
      loop
      playsinline
      disablepictureinpicture
      aria-label={t('hero.photoAlt')}
      data-i18n-attr="aria-label:hero.photoAlt"
      data-hero-video
    >
      {video.sources.map((source) => <source src={withBase(source.path)} type={source.type} />)}
    </video>

    {/* Cantos de mira — puramente decorativos. */}
    <span class="photo__corner photo__corner--tl" aria-hidden="true"></span>
    <span class="photo__corner photo__corner--tr" aria-hidden="true"></span>
    <span class="photo__corner photo__corner--bl" aria-hidden="true"></span>
    <span class="photo__corner photo__corner--br" aria-hidden="true"></span>

    <span class="photo__scan" aria-hidden="true"></span>

    <button
      type="button"
      class="photo__toggle"
      aria-label={t('hero.videoPlay')}
      data-i18n-attr="aria-label:hero.videoPlay"
      data-playing="false"
      data-hero-video-toggle
    >
      <Icon name="play" size={13} strokeWidth={2.2} class="photo__icon photo__icon--play" />
      <Icon name="pause" size={13} strokeWidth={2.6} class="photo__icon photo__icon--pause" />
    </button>

    <span class="photo__badge">
      <span class:list={['status-dot', !available && 'status-dot--off']} aria-hidden="true"></span>
      <span data-i18n="hero.photoBadge">{t('hero.photoBadge')}</span>
    </span>

    <figcaption class="photo__caption">
      <span class="photo__name">{brand.owner}</span>
      <span class="photo__role" data-i18n="hero.role">{t('hero.role')}</span>
    </figcaption>
  </div>

  <p class="photo__tag" aria-hidden="true">
    <span data-i18n="hero.photoTag">{t('hero.photoTag')}</span>
    <span class="photo__line"></span>
    <span>{siteConfig.location}</span>
  </p>
</figure>

<style>
  .photo {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: min(100%, 38rem);
    margin-inline: auto;
  }

  .photo__frame {
    position: relative;
    /* A proporção (inline, vinda do vídeo) vale para a área interna, sem a
       borda: assim o vídeo ocupa a moldura exata, sem sobra nem corte. */
    box-sizing: content-box;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-medium);
    background-color: var(--terminal-bg);
    box-shadow: var(--shadow-medium);
    overflow: hidden;
    transition:
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .photo__frame:hover {
    transform: translate(-4px, -4px);
    box-shadow: var(--shadow-large);
  }

  /* contain: o quadro inteiro sempre aparece, nada é cortado. */
  .photo__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* Leve ajuste para o vídeo casar com a paleta do site. */
    filter: contrast(1.04) saturate(0.96);
  }

  /* Véu inferior: garante contraste do texto sobre qualquer foto. */
  .photo__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(4 10 8 / 88%) 0%,
      rgb(4 10 8 / 45%) 22%,
      transparent 48%
    );
    pointer-events: none;
  }

  /* --- Cantos de mira ---------------------------------------------------- */

  .photo__corner {
    position: absolute;
    width: 26px;
    height: 26px;
    border: 2px solid var(--color-primary);
    pointer-events: none;
    z-index: 2;
  }

  .photo__corner--tl {
    top: 10px;
    left: 10px;
    border-right: none;
    border-bottom: none;
  }

  .photo__corner--tr {
    top: 10px;
    right: 10px;
    border-left: none;
    border-bottom: none;
  }

  .photo__corner--bl {
    bottom: 10px;
    left: 10px;
    border-right: none;
    border-top: none;
  }

  .photo__corner--br {
    bottom: 10px;
    right: 10px;
    border-left: none;
    border-top: none;
  }

  /* --- Linha de varredura ------------------------------------------------ */

  .photo__scan {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-primary), transparent);
    opacity: 0.55;
    pointer-events: none;
    z-index: 2;
    animation: photo-scan 5.5s var(--ease-out) infinite;
  }

  @keyframes photo-scan {
    0% {
      top: 8%;
      opacity: 0;
    }
    12% {
      opacity: 0.55;
    }
    88% {
      opacity: 0.55;
    }
    100% {
      top: 92%;
      opacity: 0;
    }
  }

  /* --- Selo, botão do vídeo e legenda ----------------------------------- */

  /* Canto esquerdo, espelhando o selo: longe do rosto em qualquer tela.
     Sem JavaScript o vídeo não toca, então o botão só aparece com JS ativo. */
  .photo__toggle {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    z-index: 3;
    display: none;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    padding: 0;
    color: #f2f7f3;
    background-color: rgb(6 14 11 / 72%);
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: 50%;
    backdrop-filter: blur(6px);
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  :global(.js) .photo__toggle {
    display: grid;
  }

  .photo__toggle:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .photo__toggle:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Área de toque maior que o círculo, sem mudar o visual. */
  .photo__toggle::before {
    content: '';
    position: absolute;
    inset: -0.45rem;
  }

  .photo__toggle :global(.photo__icon) {
    grid-area: 1 / 1;
  }

  /* Triângulo do play cheio, com o centro ótico um pouco à direita. */
  .photo__toggle :global(.photo__icon--play) {
    fill: currentColor;
    translate: 1px 0;
  }

  .photo__toggle[data-playing='true'] :global(.photo__icon--play),
  .photo__toggle[data-playing='false'] :global(.photo__icon--pause) {
    display: none;
  }

  .photo__badge {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.28rem 0.75rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: #f2f7f3;
    background-color: rgb(6 14 11 / 72%);
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: var(--radius-pill);
    backdrop-filter: blur(6px);
  }

  .photo__caption {
    position: absolute;
    left: var(--space-5);
    right: var(--space-5);
    bottom: var(--space-5);
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    text-align: left;
  }

  .photo__name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.05;
    color: #ffffff;
  }

  .photo__role {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-primary);
  }

  /* --- Rodapé fora da moldura -------------------------------------------- */

  .photo__tag {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .photo__line {
    flex: 1;
    height: 1px;
    background-color: var(--color-border-soft);
  }

  /* No mobile o vídeo vai para o topo, na largura toda: em 16:9 ele fica
     baixo o bastante para o título continuar visível. */
  @media (max-width: 1023px) {
    .photo {
      width: min(100%, 36rem);
    }

    .photo__name {
      font-size: var(--text-xl);
    }

    .photo__caption {
      left: var(--space-4);
      right: var(--space-4);
      bottom: var(--space-3);
    }

    .photo__role {
      font-size: 0.66rem;
      line-height: 1.35;
    }

    /* Os cantos de baixo sairiam por cima da legenda em tela estreita. */
    .photo__corner--bl,
    .photo__corner--br {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo__scan {
      animation: none;
      display: none;
    }

    .photo__frame:hover {
      transform: none;
    }
  }
</style>
