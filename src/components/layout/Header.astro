---
import Icon from '../common/Icon.astro';
import Logo from './Logo.astro';
import Navigation from './Navigation.astro';
import ScrollProgress from './ScrollProgress.astro';
import ThemeToggle from '../controls/ThemeToggle.astro';
import LanguageToggle from '../controls/LanguageToggle.astro';
import CommandPaletteButton from '../controls/CommandPaletteButton.astro';
import { features } from '../../config/features';
import { useTranslations } from '../../i18n';
import { DEFAULT_LANGUAGE } from '../../types/i18n';

const t = useTranslations(DEFAULT_LANGUAGE);
---

<header class="header" data-header>
  <div class="header__inner container">
    <Logo />

    <nav
      class="header__nav"
      aria-label={t('a11y.mainNavigation')}
      data-i18n-attr="aria-label:a11y.mainNavigation"
    >
      <Navigation id="primary-navigation" />
    </nav>

    <div class="header__controls">
      {features.commandPalette && <CommandPaletteButton />}
      {features.languageToggle && <LanguageToggle />}
      {features.themeToggle && <ThemeToggle />}

      <button
        type="button"
        class="header__menu-button touch-target"
        data-mobile-toggle
        aria-label={t('a11y.openMenu')}
        data-i18n-attr="aria-label:a11y.openMenu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  {features.scrollProgress && <ScrollProgress />}
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-header);
    height: var(--header-height);
    background-color: transparent;
    border-bottom: 2px solid transparent;
    transition:
      background-color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      backdrop-filter var(--duration-base) var(--ease-out);
  }

  .header.is-scrolled {
    background-color: color-mix(in srgb, var(--color-background) 88%, transparent);
    border-bottom-color: var(--color-border-soft);
    backdrop-filter: blur(10px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: 100%;
  }

  .header__nav {
    display: none;
  }

  .header__controls {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .header__menu-button {
    border: var(--border-width) solid var(--color-border-soft);
    border-radius: var(--radius-medium);
    background-color: var(--color-surface);
    color: var(--color-text);
  }

  .header__menu-button:hover {
    border-color: var(--color-border);
  }

  @media (min-width: 1024px) {
    .header__nav {
      display: block;
    }

    .header__menu-button {
      display: none;
    }
  }

  @supports not (backdrop-filter: blur(4px)) {
    .header.is-scrolled {
      background-color: var(--color-background);
    }
  }
</style>
