---
import { siteConfig } from '../../config/site';

export interface Props {
  href?: string;
  size?: 'sm' | 'md';
}

const { href = '#hero', size = 'sm' } = Astro.props;
---

<a href={href} class:list={['logo', `logo--${size}`]} aria-label={siteConfig.brand.name}>
  <span class="logo__top">{siteConfig.brand.logoTop}</span>
  <span class="logo__bottom">
    {siteConfig.brand.logoBottom}<span class="logo__cursor" aria-hidden="true">_</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    line-height: 0.92;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--color-text);
  }

  .logo--sm {
    font-size: 1.05rem;
  }

  .logo--md {
    font-size: 1.6rem;
  }

  .logo__bottom {
    color: var(--color-primary-ink);
  }

  .logo__cursor {
    display: inline-block;
    animation: blink 1.1s steps(1) infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .logo__cursor {
      animation: none;
    }
  }
</style>
