---
import SectionHeader from '../common/SectionHeader.astro';
import SkillBar from '../skills/SkillBar.astro';
import TechnologyGrid from '../skills/TechnologyGrid.astro';
import { skills } from '../../data/skills';
import { useTranslations } from '../../i18n';
import { DEFAULT_LANGUAGE } from '../../types/i18n';

const t = useTranslations(DEFAULT_LANGUAGE);
---

<section id="stack" class="section" aria-labelledby="stack-title">
  <div class="container">
    <SectionHeader
      headingId="stack-title"
      eyebrowKey="stack.eyebrow"
      titleKey="stack.title"
      subtitleKey="stack.subtitle"
      eyebrow={t('stack.eyebrow')}
      title={t('stack.title')}
      subtitle={t('stack.subtitle')}
    />

    <div class="stack">
      <div class="stack__skills card">
        <h3 class="stack__heading" data-i18n="stack.skillsTitle">{t('stack.skillsTitle')}</h3>
        <ul class="stack__skill-list" role="list">
          {skills.map((skill, index) => <SkillBar skill={skill} index={index} />)}
        </ul>
        <p class="stack__note muted" data-i18n="stack.skillsNote">{t('stack.skillsNote')}</p>
      </div>

      <div class="stack__tech">
        <h3 class="stack__heading" data-i18n="stack.technologiesTitle">
          {t('stack.technologiesTitle')}
        </h3>
        <TechnologyGrid />
      </div>
    </div>
  </div>
</section>

<style>
  .stack {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
    align-items: start;
  }

  .stack__heading {
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }

  .stack__skills {
    padding: var(--space-5);
  }

  .stack__skill-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack__note {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-soft);
    font-size: var(--text-xs);
  }

  @media (min-width: 1024px) {
    .stack {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--space-7);
    }
  }
</style>
